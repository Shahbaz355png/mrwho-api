# Copy to ".env" and fill in locally. NEVER commit a filled .env, and never
# paste real values into chat, docs, or frontend code.
# This file intentionally lists variable NAMES only.

# Port the backend listens on (default 4000)
PORT=

# Secret used to sign login session tokens (JWT). Use a long random value.
JWT_SECRET=

# SQLite database file path (optional; default ./data/mrwho.db)
DB_PATH=

# Meta app ID for the "mr who api" app (public identifier, not a secret)
META_APP_ID=

# Meta app secret — server-side ONLY. Needed for the embedded-signup code
# exchange. There is currently NO app secret in our files; until one is set
# here, POST /wa/connect/capture stores captures as "pending verification"
# and honestly reports the exchange as not configured.
META_APP_SECRET=

# Permanent system-user token for the Meta app (whatsapp_business_messaging
# + whatsapp_business_management). Used server-side for the real health
# reads in POST /wa/accounts/:id/check. Never expose to the frontend.
WA_SYSTEM_TOKEN=

# Reference IDs from the Meta app console (used by tooling/docs; the
# backend itself reads IDs per account row, not from these)
PHONE_NUMBER_ID=
WABA_ID=

# Production only: folder holding the frontend production build
# (absolute path, or relative to this backend folder). When set — or
# when a ./frontend-dist folder exists — `npm start` serves the app at
# "/" and the API under "/api" on the same port. See DEPLOY.md.
FRONTEND_DIST=
